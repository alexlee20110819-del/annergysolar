# Annergy Solar — Apache config for HostPapa (cPanel) shared hosting.
# Mirrors what vercel.json did for the Vercel deployment: clean URLs, the
# same security headers, and the same caching split between HTML and assets.
# Requires mod_rewrite, mod_headers, mod_expires, mod_deflate — all standard
# on cPanel/HostPapa shared hosting; each block is wrapped in an <IfModule>
# so nothing breaks if one happens to be missing.

Options -MultiViews -Indexes

# ---------- Clean URLs: /about serves about.html, no visible redirect ------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Leave real files and directories alone (this rule, assets/, api/, etc.)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d

  # /about -> about.html, only when about.html actually exists
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}.html -f
  RewriteRule ^([^.]+)$ $1.html [L]
</IfModule>

# ---------- 404 -------------------------------------------------------------
ErrorDocument 404 /404.html

# ---------- Security headers (same policy as the Vercel config) ------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"
  Header always set Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; script-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'self'; base-uri 'self'"
</IfModule>

# ---------- Caching: assets long-lived, HTML always revalidated ------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                "access plus 1 year"
  ExpiresByType application/javascript  "access plus 1 year"
  ExpiresByType image/png               "access plus 1 year"
  ExpiresByType image/jpeg              "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType text/html               "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|png|jpe?g|svg|webmanifest)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# ---------- Compression -----------------------------------------------------
# AddOutputFilterByType is a mod_filter directive that mod_deflate hooks into
# — guarding only on mod_deflate is not enough. Either module missing must
# not turn into a site-wide 500; nest both guards so it's skipped cleanly.
<IfModule mod_deflate.c>
  <IfModule mod_filter.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml application/json
  </IfModule>
</IfModule>

# ---------- Block PHP execution inside the images/assets tree --------------
<IfModule mod_rewrite.c>
  RewriteRule ^assets/.*\.php$ - [F,L]
</IfModule>
